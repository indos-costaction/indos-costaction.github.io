{% comment %}
This piece of Liquid template language code includes a person's details from the _data/members.yml file.
Parameters:
- id: The unique identifier of the person (required).
- coordination: "yes" or "no" to show or hide the list of coordination roles (default = "no")
- photo: "yes" or "no" to show or hide the photo (default = "yes")
- email: "yes" or "no" to show or hide the email (default = "yes")
- affiliation: "yes" or "no" to show or hide the affiliation (default = "yes")
- tag: optional short marker(s) shown next to the name; separate several with "|" (e.g. "Trainer|Organiser").
       Each marker also gets a modifier class, e.g. person-tag--trainer, for per-marker colours.
- class: optional extra class(es) on the wrapping div (e.g. "person--organiser")
{% endcomment %}

{% if include.photo == nill or include.photo == "" %}
    {% assign showphoto = "yes" %}
{% else %}
    {% assign showphoto = include.photo %}
{% endif %}

{% if include.email == nill or include.email == "" %}
    {% assign showemail = "yes" %}
{% else %}
    {% assign showemail = include.email %}
{% endif %}

{% if include.coordination == nill or include.coordination == "" %}
    {% assign showcoordination = "no" %}
{% else %}
    {% assign showcoordination = include.coordination %}
{% endif %}

{% if include.institution == nill or include.institution == "" %}
    {% assign showinstitution = "yes" %}
{% else %}
    {% assign showinstitution = include.institution %}
{% endif %}

{% assign person = site.data.members | where: "id", include.id | first %}

{% if person %}
<div class="person{% if include.class %} {{ include.class }}{% endif %}">
    <h4>
    {{ person.name }}{% if include.tag %}{% assign tags = include.tag | split: "|" %} <span class="person-tags">{% for tag in tags %}{% assign tagname = tag | strip %}<span class="person-tag person-tag--{{ tagname | downcase | replace: ' ', '-' }}">{{ tagname }}</span> {% endfor %}</span>{% endif %}
    </h4>
    {% if showphoto == "yes" %}
        {% if person.photo %}
            <p class="person-photo-wrap"><img class="person-photo" src="{{ person.photo }}" alt=""></p>
        {% else %}
            <p class="person-photo-wrap"><img class="person-photo" src="/assets/images/people/avatar.jpg" alt=""></p>
        {% endif %}
    {% endif %}
    {% if showemail == "yes" %}
        {% if person.email %}
            {% assign email_parts = person.email | split: "@" %}
            {% comment %} Email protection adapted from https://joemaller.com/js-mailer.shtml by Joe Maller. {% endcomment %}
            <p class="person-email"><script>
              (function () {
                var emailAddress = {{ email_parts[0] | jsonify }} + "@" + {{ email_parts[1] | jsonify }};
                document.write('<a href="mailto:' + emailAddress + '">' + emailAddress + '</a>');
              }());
            </script></p>
        {% else %}
            <p>&nbsp;</p>
        {% endif %}
    {% endif %}
    {% if showcoordination == "yes" %}
        {% if person.coordination %}
            <p class="person-roles">
            {% for role in person.coordination %}
                {{ role }}{% unless forloop.last %}<br>{% endunless %}
            {% endfor %}
            </p>
        {% endif %}
    {% endif %}
    {% if showinstitution == "yes" %}
        {% if person.institution %}
            <p class="person-">{{ person.institution }}</p>
        {% else %}
            <p>&nbsp;</p>
        {% endif %}
    {% endif %}
</div>
{% endif %}
